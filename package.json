{
  "name": "whyrn.dev",
  "version": "0.2.0",
  "description": "See exactly why your React Native components re-render",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli lib",
    "prepack": "bob build"
  },
  "keywords": [
    "react-native",
    "react",
    "debug",
    "re-render",
    "performance",
    "profiler",
    "devtools",
    "why-did-you-render"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladbars/whyrn.git"
  },
  "author": "Vladislav Baranov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vladbars/whyrn/issues"
  },
  "homepage": "https://github.com/vladbars/whyrn#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "del-cli": "^5.1.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
